{
  "version": "0.1.0",
  "name": "PLCnext AXC F 3152 — Live Demo",
  "datasources": [
    {
      "id": "plc",
      "type": "rest",
      "label": "PLCnext AXC F 3152",
      "config": {
        "endpoint": "https://10.0.0.210",
        "basePath": "/_pxc_api/v1.14"
      }
    }
  ],
  "pages": [
    {
      "id": "p-demo",
      "name": "PLC Demo",
      "widgets": [
        {
          "id": "w-gauge",
          "type": "gauge",
          "x": 0, "y": 0, "w": 4, "h": 3,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.iInteger",
          "config": {
            "label": "Integer Value",
            "min": 0, "max": 1000, "unit": "units",
            "thresholds": [
              { "value": 700, "color": "#f59e0b" },
              { "value": 900, "color": "#ef4444" }
            ]
          }
        },
        {
          "id": "w-numeric",
          "type": "numericDisplay",
          "x": 4, "y": 0, "w": 3, "h": 2,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.restInteger",
          "config": {
            "label": "Rest Integer",
            "unit": "cnt",
            "decimals": 0
          }
        },
        {
          "id": "w-led",
          "type": "led",
          "x": 7, "y": 0, "w": 2, "h": 2,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.xBool_Out",
          "config": {
            "label": "Bool Out",
            "trueLabel": "ACTIVE",
            "falseLabel": "IDLE",
            "trueColor": "#22c55e",
            "falseColor": "#ef4444"
          }
        },
        {
          "id": "w-button",
          "type": "button",
          "x": 9, "y": 0, "w": 3, "h": 2,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.xBool_API",
          "config": {
            "label": "Toggle API Bool",
            "momentary": false,
            "onValue": true,
            "offValue": false
          }
        },
        {
          "id": "w-multistate",
          "type": "multiState",
          "x": 4, "y": 2, "w": 3, "h": 2,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.xBool_Out",
          "config": {
            "label": "Bool State",
            "states": [
              { "value": false, "label": "OFFLINE", "color": "#27272a", "textColor": "#71717a" },
              { "value": true,  "label": "ONLINE",  "color": "#052e16", "textColor": "#4ade80" }
            ]
          }
        },
        {
          "id": "w-numinput",
          "type": "numericInput",
          "x": 7, "y": 2, "w": 2, "h": 2,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.xBool_In",
          "config": {
            "label": "Write Bool In",
            "unit": ""
          }
        },
        {
          "id": "w-setpoint",
          "type": "setpoint",
          "x": 9, "y": 2, "w": 3, "h": 2,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.xBool_In",
          "config": {
            "label": "Bool In Setpoint",
            "min": 0, "max": 1, "step": 1,
            "unit": ""
          }
        },
        {
          "id": "w-tank",
          "type": "tank",
          "x": 0, "y": 3, "w": 2, "h": 4,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.iInteger",
          "config": {
            "label": "Integer Tank",
            "min": 0, "max": 1000, "unit": "units",
            "thresholds": [
              { "value": 800, "color": "#f59e0b" },
              { "value": 950, "color": "#ef4444" }
            ]
          }
        },
        {
          "id": "w-trend",
          "type": "trend",
          "x": 2, "y": 3, "w": 7, "h": 4,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.iInteger",
          "config": {
            "label": "Integer Trend",
            "duration": 120,
            "tags": [
              { "binding": "plc:Arp.Plc.Eclr/MainInstance.iInteger",    "color": "#3b82f6", "label": "iInteger" },
              { "binding": "plc:Arp.Plc.Eclr/MainInstance.restInteger", "color": "#22c55e", "label": "restInteger" }
            ]
          }
        },
        {
          "id": "w-textinput",
          "type": "textInput",
          "x": 9, "y": 3, "w": 3, "h": 2,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.sString",
          "config": {
            "label": "String Value",
            "placeholder": "enter string…"
          }
        },
        {
          "id": "w-history",
          "type": "historyLog",
          "x": 0, "y": 7, "w": 12, "h": 4,
          "binding": "plc:Arp.Plc.Eclr/MainInstance.iInteger",
          "config": {
            "label": "Integer History Log",
            "pageSize": 25
          }
        }
      ]
    }
  ],
  "alarmRules": [
    {
      "id": "alarm-integer-high",
      "name": "Integer High",
      "binding": "plc:Arp.Plc.Eclr/MainInstance.iInteger",
      "condition": "gt",
      "threshold": 900,
      "severity": "warning",
      "message": "Integer value above 900"
    }
  ]
}
